{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "stimulusRef",
    "sourceScenarioId",
    "sourceVariantId",
    "fixtureValid"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stimulusRef": {
      "type": "string",
      "pattern": "^STIMULUS-[a-f0-9-]{36}$"
    },
    "sourceScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVariantId": {
      "type": "string",
      "minLength": 1
    },
    "fixtureValid": {
      "type": "boolean"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skltp-next:experiment-001:stimulus-result-phase-5:1.0.0"
}

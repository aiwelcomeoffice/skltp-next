              "ambiguous-endpoint",
              "ambiguous-ref",
              "baseline",
              "digest-mutation",
              "iam-as-signing-key-revoked-after-bound",
              "iam-client-wrong-key",
              "iam-client-wrong-system",
              "iam-cross-context",
              "iam-manipulated",
              "iam-rollback",
              "iam-stale",
              "iam-system-wrong-organization",
              "iam-unknown-client",
              "iam-unknown-organization",
              "iam-unknown-system",
              "iam-wrong-key",
              "iam-wrong-metadata-issuer",
              "inactive-A-existing-token-after-offboarding",
              "inactive-A-token-request-after-offboarding",
              "inactive-B-before-token",

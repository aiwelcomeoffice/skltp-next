{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skltp-next:experiment-001:schema:scenario-result-phase-3:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "variantId",
    "releaseId",
    "releaseVersion",
    "parameterSetId",
    "expected",
    "actual",
    "status",
    "checkpoints",
    "telemetryRef",
    "auditRef",
    "contractValidation",
    "leakageValidation"
  ],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "runId": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,64}$"},
    "scenarioId": {"const": "E001-REL-001"},
    "variantId": {"enum": ["missing-ref", "ambiguous-ref", "digest-mutation"]},
    "releaseId": {"const": "E001-RELEASE"},
    "releaseVersion": {"const": "1.0.0"},
    "parameterSetId": {"const": "E001-PARAMS-1.0.0"},
    "expected": {"const": "deny"},
    "actual": {"enum": ["allow", "deny", "harness-error"]},
    "status": {"enum": ["pass", "fail", "inconclusive"]},
    "checkpoints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "telemetryRef": {"type": "string"},
    "auditRef": {"type": ["string", "null"]},
    "contractValidation": {"enum": ["pass", "not-applicable"]},
    "leakageValidation": {"const": "pending-collection"}
  }
}

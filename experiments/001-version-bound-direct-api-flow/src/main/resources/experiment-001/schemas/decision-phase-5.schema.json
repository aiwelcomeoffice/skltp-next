{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skltp-next:experiment-001:decision-phase-5:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "stimulusRef",
    "sourceScenarioId",
    "sourceVariantId",
    "checkpoint",
    "reason",
    "scenarioId",
    "variantId",
    "actor",
    "category",
    "result",
    "releaseId",
    "releaseVersion",
    "profileVersion",
    "policyVersion",
    "decisionRef",
    "auditRef",
    "traceId",
    "spanId"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stimulusRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVariantId": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "enum": [
        "E001-OBS-001",
        "E001-OBS-002"
      ]
    },
    "variantId": {
      "const": "baseline"
    },
    "actor": {
      "enum": [
        "authorization-server",
        "producer"
      ]
    },
    "category": {
      "enum": [
        "client_authentication",
        "token_validation",
        "sender_constraint",
        "authorization"
      ]
    },
    "result": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "releaseId": {
      "const": "E001-RELEASE"
    },
    "releaseVersion": {
      "const": "1.0.0"
    },
    "profileVersion": {
      "const": "1.0.0"
    },
    "policyVersion": {
      "enum": [
        "1.0.0",
        "phase-2-local-deny-1.0.0"
      ]
    },
    "decisionRef": {
      "type": "string",
      "pattern": "^DECISION-[a-f0-9-]{36}$"
    },
    "auditRef": {
      "type": "string",
      "pattern": "^AUDIT-[a-f0-9-]{36}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    }
  }
}
